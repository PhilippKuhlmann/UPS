# ── NUT-Server ────────────────────────────────────────────────────────────
# Diese Angaben werden nur beim allerersten Start in die Datenbank übernommen.
# Danach ist die Tabelle `nut_servers` maßgeblich und wird in der Oberfläche
# unter „Server" gepflegt — Änderungen hier wirken dann nicht mehr.
# Wer ohne Vorbelegung starten will, lässt einfach alles weg und legt den
# Server nach dem ersten Login über die Oberfläche an.
NUT_HOST=192.168.1.10
NUT_PORT=3493
NUT_NAME=nas

# Zugangsdaten sind nur für INSTCMD / SET VAR nötig. Lesen geht anonym,
# solange upsd es erlaubt. Der Benutzer braucht `instcmds = ALL` in upsd.users.
# NUT_USERNAME=monuser
# NUT_PASSWORD=secret

# Mehrere Server auf einmal vorbelegen — JSON-Array in einer Zeile:
# NUT_SERVERS=[{"name":"nas","host":"192.168.1.10","port":3493},{"name":"rack","host":"10.0.0.5","port":3493,"username":"monuser","password":"secret"}]

# ── Anmeldung ─────────────────────────────────────────────────────────────
# Beim ersten Start wird das Konto „admin" mit dem Passwort „admin" angelegt;
# es muss beim ersten Login ersetzt werden.
# Wird ADMIN_PASSWORD gesetzt, gilt dieses Passwort sofort und es gibt keine
# erzwungene Änderung — sinnvoll für Docker.
# ADMIN_PASSWORD=

# Sitzungsdauer in Stunden (Vorgabe 336 = 14 Tage).
SESSION_TTL_HOURS=336

# Auf 1 setzen, wenn die App hinter HTTPS läuft: das Sitzungs-Cookie wird dann
# nur noch verschlüsselt übertragen.
SESSION_COOKIE_SECURE=0

# Nur auf 0 setzen, wenn bereits etwas davor authentifiziert (Reverse Proxy,
# VPN). Dann sind Oberfläche und API ohne Anmeldung erreichbar.
AUTH_ENABLED=1

# ── WebApp ────────────────────────────────────────────────────────────────
PORT=8080
BIND_HOST=0.0.0.0

# ── Abfrage & Verlauf ─────────────────────────────────────────────────────
POLL_INTERVAL_MS=5000
HISTORY_RETENTION_DAYS=30
DB_PATH=./data/ups.db

# ── Alarmschwellen ────────────────────────────────────────────────────────
ALERT_CHARGE_BELOW=30
ALERT_LOAD_ABOVE=85
ALERT_RUNTIME_BELOW_SECONDS=300
ALERT_TEMPERATURE_ABOVE=45

# Meldewege (E-Mail, Telegram, Webhook) werden in der Oberfläche unter
# „Meldungen" eingerichtet und liegen in der Datenbank. Diese Variable belegt
# nur beim allerersten Start den Webhook vor.
# ALERT_WEBHOOK_URL=https://homeassistant.local/api/webhook/ups-alert
